<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <_ReleaseVersionPath>$(MSBuildThisFileDirectory)../release-version.json</_ReleaseVersionPath>
    <_ReleaseVersionJson Condition="Exists('$(_ReleaseVersionPath)')">$([System.IO.File]::ReadAllText('$(_ReleaseVersionPath)'))</_ReleaseVersionJson>
    <Version Condition="'$(Version)' == '' and '$(_ReleaseVersionJson)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_ReleaseVersionJson)', '(?s).*&quot;version&quot;\s*:\s*&quot;([0-9.]+)&quot;.*', '$1'))</Version>
    <_ReleaseBuild Condition="'$(_ReleaseVersionJson)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_ReleaseVersionJson)', '(?s).*&quot;build&quot;\s*:\s*([0-9]+).*', '$1'))</_ReleaseBuild>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <_ReleaseBuild Condition="'$(_ReleaseBuild)' == ''">23</_ReleaseBuild>
    <FileVersion>$(Version).$(_ReleaseBuild)</FileVersion>
    <Company>KeyWoo</Company>
    <Product>KeyWoo</Product>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=/_/KeyWoo</PathMap>
  </PropertyGroup>
</Project>
